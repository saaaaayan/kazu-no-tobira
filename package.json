{
  "name": "kazu-no-tobira",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "bank:build": "node scripts/build-question-banks.mjs",
    "bank:check": "node scripts/build-question-banks.mjs --check",
    "bank:audit": "node scripts/audit-question-quality.mjs",
    "bank:audit:check": "node scripts/audit-question-quality.mjs --check",
    "bank:quality-gate": "node scripts/audit-question-quality.mjs --require-reviewed",
    "beta:readiness": "node scripts/check-beta-readiness.mjs",
    "test": "pnpm bank:check && pnpm bank:audit:check && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "mathjax-full": "3.2.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
