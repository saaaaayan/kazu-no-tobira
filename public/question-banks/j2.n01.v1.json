      "question": "2x + 3x を整理すると？",
      "prompt": "正しい答えを選びましょう。",
      "choices": [
        "5x",
        "6x",
        "5x²",
        "-1x"
      ],
      "answer": "5x",
      "hint": "同類項かどうかを確認しよう。",
      "hints": [
        "同類項かどうかを確認しよう。",
        "同じ文字部分xをくくる。",
        "係数だけを足して文字部分は変えない。"
      ],
      "explanation": "5x です。",
      "steps": [
        {
          "title": "考え方",
          "body": "同じ文字部分xをくくる。"
        },
        {
          "title": "途中の計算・理由",
          "body": "2x＋3x＝(2＋3)x＝5x。"
        },
        {
          "title": "確認",
          "body": "5x です。"
        }
